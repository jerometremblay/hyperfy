{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jerometremblay.github.io/hyperfy/schemas/settings.schema.json",
  "title": "Portable Hyperfy world settings",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 1 },
    "title": { "type": ["string", "null"], "maxLength": 256 },
    "description": { "type": ["string", "null"], "maxLength": 4096 },
    "desc": { "type": ["string", "null"], "maxLength": 4096 },
    "image": { "$ref": "#/$defs/assetDescriptor" },
    "avatar": { "$ref": "#/$defs/assetDescriptor" },
    "dayNightCycle": { "type": "boolean" },
    "constellationLines": { "type": "boolean" },
    "skyAppearance": { "type": "number", "minimum": 0, "maximum": 100 },
    "bortleClass": { "type": "integer", "minimum": 1, "maximum": 9 },
    "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
    "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
    "timeZone": { "type": "string", "minLength": 1 },
    "spawn": {
      "type": "object",
      "required": ["position", "quaternion"],
      "properties": {
        "position": { "$ref": "scene.schema.json#/$defs/vector3" },
        "quaternion": { "$ref": "scene.schema.json#/$defs/quaternion" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "assetDescriptor": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
