{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jerometremblay.github.io/hyperfy/schemas/scene.schema.json",
  "title": "Hyperfy scene source",
  "type": "object",
  "required": ["schemaVersion", "sceneKey", "instances"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sceneKey": { "$ref": "#/$defs/sceneKey" },
    "title": { "type": "string", "maxLength": 256 },
    "environment": { "$ref": "object.schema.json#/$defs/key" },
    "settingsFile": { "type": "string", "minLength": 1 },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "object", "position", "quaternion", "scale", "pinned"],
        "properties": {
          "key": { "$ref": "object.schema.json#/$defs/key" },
          "object": { "$ref": "object.schema.json#/$defs/key" },
          "position": { "$ref": "#/$defs/vector3" },
          "quaternion": { "$ref": "#/$defs/quaternion" },
          "scale": { "$ref": "#/$defs/positiveVector3" },
          "pinned": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sceneKey": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"
    },
    "vector3": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "positiveVector3": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "number", "exclusiveMinimum": 0 }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "quaternion": {
      "description": "Finite [x,y,z,w] unit quaternion; runtime validator accepts norm error up to 0.001.",
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    }
  },
  "additionalProperties": false
}
