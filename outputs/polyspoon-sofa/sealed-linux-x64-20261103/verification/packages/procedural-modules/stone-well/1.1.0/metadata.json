  "id": "stone-well",
  "version": "1.1.0",
  "title": "Stone well",
  "description": "Open masonry shaft, timber shelter, windlass and suspended bucket.",
  "controls": [
    {
      "key": "diameter",
      "label": "Outside diameter",
      "kind": "range",
      "group": "shape",
      "min": 1.8,
      "max": 3.2,
      "step": 0.05,
      "default": 2.2,
      "hint": "Outside masonry diameter. Shaft stays open with 25 cm walls.",
      "affects": [
        "geometry"
      ],
      "targets": [
        "stone",
        "coping",
        "post",
        "windlass",
        "roof-board"
      ],
      "unit": "m",
      "inputUnit": "m",
      "displayUnit": "m"
    },
    {
      "key": "wallHeight",
      "label": "Wall height",
      "kind": "range",
      "group": "shape",
      "min": 0.65,
      "max": 1.4,
      "step": 0.05,
      "default": 0.95,
      "hint": "Ground to coping top. Timber and mechanism follow the wall.",
      "affects": [
        "geometry",
        "topology"
      ],
      "targets": [
        "stone",
        "coping",
        "post",
        "windlass",
        "bucket-shell"
      ],
      "unit": "m",
      "inputUnit": "m",
      "displayUnit": "m"
    },
    {
      "key": "roofSize",
      "label": "Roof size",
      "kind": "range",
      "group": "shape",
      "ratioBasis": "width",
      "min": 1.15,
      "max": 1.6,
      "step": 0.05,
      "default": 1.35,
      "hint": "Roof width as a multiple of well diameter. Depth is 85 percent of width.",
      "affects": [
        "geometry",
        "topology"
      ],
      "targets": [
        "roof-board",
        "rafter",
        "ridge"
      ],
      "unit": "ratio",
      "inputUnit": "dimensionless",
      "displayUnit": "ratio"
    },
    {
      "key": "roof",
      "label": "Timber roof",
      "kind": "toggle",
      "group": "construction",
      "default": true,
      "hint": "Roof boards, rafters and braces; posts remain with an open top.",
      "affects": [
        "topology"
      ],
      "targets": [
        "roof-board",
        "rafter",
        "ridge",
        "fascia",
        "tie",
        "brace",
        "post"
      ],
      "unit": "none",
      "inputUnit": "none",
      "displayUnit": "none"
    },
    {
      "key": "bucket",
      "label": "Suspended bucket",
      "kind": "toggle",
      "group": "construction",
      "default": true,
      "hint": "Bucket, handle and hanging rope. Requires the windlass.",
      "affects": [
        "topology"
      ],
      "targets": [
        "bucket",
        "hanging-rope"
      ],
      "unit": "none",
      "inputUnit": "none",
      "displayUnit": "none"
    },
    {
      "key": "windlass",
      "label": "Windlass mechanism",
      "kind": "toggle",
      "group": "construction",
      "default": true,
      "hint": "Axle, bearings, crank and rope spool. Remove the bucket before disabling.",
      "affects": [
        "topology"
      ],
      "targets": [
        "windlass",
        "axle-bearing",
        "spool-flange",
        "crank",
        "rope-coil"
      ],
      "unit": "none",
      "inputUnit": "none",
      "displayUnit": "none"
    },
    {
      "key": "bucketDrop",
      "label": "Bucket drop",
      "kind": "range",
      "group": "construction",
      "min": 0,
      "max": 0.6,
      "step": 0.05,
      "default": 0,
      "hint": "Lowers the bucket from its default height and lengthens the hanging rope.",
      "affects": [
        "geometry"
      ],
      "targets": [
        "bucket",
        "hanging-rope"
      ],
      "unit": "m",
      "inputUnit": "m",
      "displayUnit": "m"
    },
