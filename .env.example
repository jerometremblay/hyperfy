# The world folder to run
WORLD=world

# The port the server runs on 
PORT=3000

# Optional direct HTTPS/WSS. Set both paths together, or leave both empty for HTTP.
TLS_KEY_FILE=
TLS_CERT_FILE=

# The secret the server uses to create/parse json web tokens
# Recommended: use a random string of at least 16 characters in production
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# The code used to become admin in the world (type /admin <code> in chat)
# If left blank, everyone is an admin!
ADMIN_CODE=

# How often the world saves (seconds) 
# Can be set to 0 to disable saving
SAVE_INTERVAL=60

# Whether players should collide with other players
PUBLIC_PLAYER_COLLISION=false

# The maximum upload file size for models etc (mb), or 0 for unlimited
PUBLIC_MAX_UPLOAD_SIZE=0

# The public web socket url the client connects to
# IMPORTANT: Use wss:// and https:// in production!
PUBLIC_WS_URL=ws://localhost:3000/ws

# The public url used by clients to access api (eg upload assets)
# IMPORTANT: Use https:// in production!
PUBLIC_API_URL=http://localhost:3000/api

# Optional origin for named world profiles (npm run dev/start -- <profile>).
# Derives PUBLIC_WS_URL, PUBLIC_API_URL and ASSETS_BASE_URL unless explicitly overridden.
PUBLIC_ORIGIN=

# CORS origin whitelist (optional, defaults to allow all)
# Set to your domain in production, e.g. https://myworld.example.com
CORS_ORIGIN=

# How assets are stored, fetched and uploaded (local or s3)
ASSETS=local
ASSETS_BASE_URL=http://localhost:3000/assets
ASSETS_S3_URI=

# By default world data is stored in a local sqlite database in the world folder
# Optionally set this to a postgres uri to store remotely, eg `postgres://username:password@host:port/database`
DB_URI=local
DB_SCHEMA=

# Whether the server should do a cleanup of unused blueprints and assets before launching
CLEAN=true

# Optional build identifier exposed by the server status endpoint
COMMIT_HASH=

# LiveKit (voice chat)
LIVEKIT_WS_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=


##
# AI
# --
# AI_PROVIDER: openai, anthropic, xai, google
# AI_MODEL: claude-opus-4-1-20250805, claude-sonnet-4-20250514, gpt-5, gpt-5-mini, gpt-5-nano, grok-4-0709, gemini-2.5-pro, gemini-2.5-flash
# AI_EFFORT: minimal, low, medium, high (OpenAI only)
# AI_API_KEY: The api key for the selected provider
##
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-20250514
AI_EFFORT=medium
AI_API_KEY=
# Optional custom OpenAI-compatible endpoint (used with AI_PROVIDER=openai)
AI_BASE_URL=

# Server-side browser capture
# Leave empty to allow automatic local Chrome startup at http://127.0.0.1:9222.
# Set an endpoint only when using an externally managed Chrome.
BROWSER_CDP_URL=
# Optional Chrome executable path; CHROME_PATH is a fallback alias.
BROWSER_CHROME_PATH=
CHROME_PATH=
BROWSER_HEADLESS=true
# Explicit opt-in to launching Chrome as root on Linux without its sandbox
BROWSER_ALLOW_UNSANDBOXED_CHROME=false

# Optional agent REST API (disabled when both are empty). Never prefix these with PUBLIC_.
AGENT_API_READ_TOKEN=
AGENT_API_WRITE_TOKEN=
